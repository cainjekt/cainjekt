{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "caBundle": {
      "type": "object",
      "properties": {
        "source": { "enum": ["configMap", "inline", "clusterTrustBundle"] },
        "configMap": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "inline": { "type": "string" },
        "clusterTrustBundle": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "signerName": { "type": "string" },
            "labelSelector": { "type": "object" },
            "optional": { "type": "boolean" }
          }
        }
      }
    },
    "plugin": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "string", "pattern": "^[0-9]{2}$" }
      }
    },
    "failPolicy": { "enum": ["fail-open", "fail-closed"] },
    "hookTimeoutSec": { "type": "integer", "minimum": 2, "maximum": 120 },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "httpServer": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
